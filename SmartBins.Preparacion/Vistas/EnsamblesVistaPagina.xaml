<Page x:Class="SmartBins.Vistas.EnsamblesVistaPagina"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Ensambles"
      Background="#F4F6F8"
      FontFamily="Segoe UI">

    <Page.Resources>
        <SolidColorBrush x:Key="Primary" Color="#0B67C2"/>
        <SolidColorBrush x:Key="PrimaryHover" Color="#0959A9"/>
        <SolidColorBrush x:Key="Danger" Color="#C62828"/>
        <SolidColorBrush x:Key="DangerHover" Color="#A92020"/>
        <SolidColorBrush x:Key="Border" Color="#D9DEE7"/>
        <SolidColorBrush x:Key="TextMain" Color="#1D2939"/>
        <SolidColorBrush x:Key="TextMuted" Color="#667085"/>

        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="14" ShadowDepth="2"
                          Direction="270" Opacity="0.11"/>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E7EAF0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
        </Style>

        <Style x:Key="RoundedTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="{StaticResource Primary}"/>
                                <Setter TargetName="InputBorder" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource Primary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource PrimaryHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button"
               BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="{StaticResource Danger}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource DangerHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="8">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#F3F7F4"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#E4EFE8"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#8CAF98"/>
                                <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="Ensambles"
                           FontSize="26" FontWeight="SemiBold"
                           Foreground="{StaticResource TextMain}"/>
                <TextBlock Text="Consulta, revisa y administra las hojas de operación registradas."
                           Margin="0,4,0,0" FontSize="13"
                           Foreground="{StaticResource TextMuted}"/>
            </StackPanel>

            <Border HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Padding="13,7"
                    Background="#EAF3FC"
                    BorderBrush="#CFE2F6"
                    BorderThickness="1"
                    CornerRadius="9">
                <TextBlock Foreground="{StaticResource Primary}">
                    <Run Text="Registrados "/>
                    <Run x:Name="TxtTotalEnsambles" Text="0" FontWeight="Bold"/>
                </TextBlock>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" MinWidth="310"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Panel de búsqueda y listado -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="Ensambles registrados"
                                   FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMain}"/>
                        <TextBlock Text="Selecciona uno para consultar su secuencia."
                                   Margin="0,3,0,0" FontSize="12"
                                   Foreground="{StaticResource TextMuted}"/>
                    </StackPanel>

                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBox x:Name="TxtBuscar"
                                 Style="{StaticResource RoundedTextBox}"
                                 ToolTip="Buscar por nombre"
                                 TextChanged="TxtBuscar_TextChanged"/>
                        <ComboBox Grid.Row="2"
                                  x:Name="CmbFiltroUnidad"
                                  Style="{StaticResource ProfessionalComboBoxStyle}"
                                  SelectionChanged="CmbFiltroUnidad_SelectionChanged">
                            <ComboBoxItem Content="Todas" IsSelected="True"/>
                            <ComboBoxItem Content="Interunit"/>
                            <ComboBoxItem Content="Commercial Vehicle"/>
                            <ComboBoxItem Content="Embedded Power"/>
                        </ComboBox>
                    </Grid>

                    <Border Grid.Row="4"
                            Background="#FAFBFC"
                            BorderBrush="#E4E7EC"
                            BorderThickness="1"
                            CornerRadius="9"
                            Padding="3">
                        <ListBox x:Name="ListaEnsambles"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 SelectionChanged="ListaEnsambles_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Nombre}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding UnidadTrabajo}" Margin="0,3,0,0"
                                                       FontSize="11" Foreground="#667085"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding Estado}" HorizontalAlignment="Right"
                                                       FontSize="11" FontWeight="SemiBold" Foreground="#2E7D32"/>
                                            <TextBlock HorizontalAlignment="Right" FontSize="10" Foreground="#667085">
                                                <Run Text="Rev. "/><Run Text="{Binding Revision}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <Grid Grid.Row="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Editar"
                                Style="{StaticResource ActionButton}"
                                Click="Editar_Click"/>
                        <Button Grid.Column="2" Content="Eliminar"
                                Style="{StaticResource DangerButton}"
                                Click="Eliminar_Click"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- Detalle -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <StackPanel>
                            <TextBlock x:Name="TxtNombreEnsamble"
                                       Text="Detalle del ensamble"
                                       FontWeight="SemiBold" FontSize="18"
                                       Foreground="{StaticResource Primary}"/>
                            <TextBlock x:Name="TxtTiempoTotal"
                                       Text="Selecciona un ensamble para consultar sus datos."
                                       Margin="0,5,0,0"
                                       Foreground="{StaticResource TextMuted}"
                                       FontSize="12"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="2">
                        <DataGrid x:Name="GridSecuencia"
                                  Style="{StaticResource ProfessionalDataGridStyle}"
                                  IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding OrdenSecuencia}" Width="45"/>
                                <DataGridTextColumn Header="Est." Binding="{Binding EstacionAsignada}" Width="55"/>
                                <DataGridTextColumn Header="Tipo" Binding="{Binding NombreComponente}" Width="135"/>
                                <DataGridTextColumn Header="Especificación" Binding="{Binding EspecificacionComponente}" Width="*"/>
                                <DataGridTextColumn Header="Tiempo (seg)" Binding="{Binding TiempoEstimado}" Width="105"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel x:Name="PanelSinSeleccion"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    IsHitTestVisible="False">
                            <Border Width="64" Height="64"
                                    HorizontalAlignment="Center"
                                    Background="#EAF3FC"
                                    CornerRadius="32">
                                <TextBlock Text="▤"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="28"
                                           Foreground="{StaticResource Primary}"/>
                            </Border>
                            <TextBlock Text="Selecciona un ensamble"
                                       Margin="0,14,0,0"
                                       HorizontalAlignment="Center"
                                       FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextMain}"/>
                            <TextBlock Text="Aquí aparecerán su información y secuencia de operaciones."
                                       Margin="0,5,0,0"
                                       HorizontalAlignment="Center"
                                       Foreground="{StaticResource TextMuted}"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
