<Page x:Class="SmartBins.Vistas.InventarioVistaPagina"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="700"
      d:DesignWidth="1200"
      Title="Inventario"
      Background="#F4F6F8"
      FontFamily="Segoe UI"
      SnapsToDevicePixels="True">

    <Page.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#0B67C2"/>
        <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#0959A9"/>
        <SolidColorBrush x:Key="PrimaryLightBrush" Color="#EAF3FC"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#C62828"/>
        <SolidColorBrush x:Key="DangerHoverBrush" Color="#A92020"/>
        <SolidColorBrush x:Key="NeutralBrush" Color="#667085"/>
        <SolidColorBrush x:Key="NeutralHoverBrush" Color="#525D70"/>
        <SolidColorBrush x:Key="PageBackgroundBrush" Color="#F4F6F8"/>
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SoftBackgroundBrush" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#D9DEE7"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1D2939"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#667085"/>

        <!-- ============================================================= -->
        <!-- PALETA DE COLORES                                              -->
        <!-- ============================================================= -->

        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="14"
                          ShadowDepth="2"
                          Direction="270"
                          Opacity="0.12"/>

        <!-- ============================================================= -->
        <!-- CONTENEDORES                                                   -->
        <!-- ============================================================= -->

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="#E7EAF0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
        </Style>

        <Style x:Key="SectionPanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SoftBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="#E4E7EC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <!-- ============================================================= -->
        <!-- TEXTOS                                                         -->
        <!-- ============================================================= -->

        <Style x:Key="PageTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>

        <Style x:Key="PageSubtitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        </Style>

        <!-- ============================================================= -->
        <!-- CAMPOS DE CAPTURA                                              -->
        <!-- ============================================================= -->

        <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="InputBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource PrimaryBrush}"/>
                                <Setter TargetName="InputBorder"
                                        Property="BorderThickness"
                                        Value="1.5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="InputBorder"
                                        Property="Background"
                                        Value="#F2F4F7"/>
                                <Setter Property="Foreground" Value="#98A2B3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InputComboBoxStyle" TargetType="ComboBox"
               BasedOn="{StaticResource ProfessionalComboBoxStyle}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- ============================================================= -->
        <!-- BOTONES                                                        -->
        <!-- ============================================================= -->

        <Style x:Key="BaseButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="92"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{StaticResource PrimaryHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.78"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource BaseButtonStyle}"/>

        <Style x:Key="DangerButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{StaticResource DangerHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.78"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NeutralButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="{StaticResource NeutralBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{StaticResource NeutralHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.78"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Background" Value="{StaticResource PrimaryLightBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#CFE2F6"
                                BorderThickness="1"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#DCEBFA"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.78"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================================= -->
        <!-- TABLAS                                                         -->
        <!-- ============================================================= -->

        <Style x:Key="DataGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Background" Value="#F2F4F7"/>
            <Setter Property="Foreground" Value="#344054"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderBrush" Value="#E4E7EC"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="DataGridCellStyle" TargetType="DataGridCell">
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>

        <Style x:Key="DataGridRowStyle" TargetType="DataGridRow">
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#EEF0F3"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#FAFBFC"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F3F7F4"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E4EFE8"/>
                    <Setter Property="BorderBrush" Value="#8CAF98"/>
                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="InventoryDataGridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserReorderColumns" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="AlternationCount" Value="2"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E4E7EC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource DataGridColumnHeaderStyle}"/>
            <Setter Property="CellStyle" Value="{StaticResource DataGridCellStyle}"/>
            <Setter Property="RowStyle" Value="{StaticResource DataGridRowStyle}"/>
            <Setter Property="EnableRowVirtualization" Value="True"/>
            <Setter Property="EnableColumnVirtualization" Value="True"/>
        </Style>

        <!-- ============================================================= -->
        <!-- ESTATUS                                                        -->
        <!-- ============================================================= -->

        <DataTemplate x:Key="EstatusTemplate">
            <Ellipse Width="10"
                     Height="10"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     ToolTip="{Binding Estatus}">
                <Ellipse.Style>
                    <Style TargetType="Ellipse">
                        <Setter Property="Fill" Value="#98A2B3"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Estatus}" Value="Actualizado">
                                <Setter Property="Fill" Value="#2E7D32"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Estatus}" Value="Desactualizado">
                                <Setter Property="Fill" Value="#C62828"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Ellipse.Style>
            </Ellipse>
        </DataTemplate>



        <!-- ============================================================= -->
        <!-- NAVEGACIÓN DE PESTAÑAS                                        -->
        <!-- ============================================================= -->

        <Style x:Key="InventoryTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local"
                              SnapsToDevicePixels="True">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="14"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Selector de inventario y herramientas -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        HorizontalAlignment="Left"
                                        Padding="5"
                                        Background="#E8EDF3"
                                        BorderBrush="#D7DEE8"
                                        BorderThickness="1"
                                        CornerRadius="13">
                                    <TabPanel x:Name="HeaderPanel"
                                              IsItemsHost="True"
                                              KeyboardNavigation.TabIndex="1"
                                              Panel.ZIndex="1"/>
                                </Border>

                                <ContentPresenter Grid.Column="2"
                                                  Content="{TemplateBinding Tag}"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Contenido de la pestaña seleccionada -->
                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                              Grid.Row="2"
                                              ContentSource="SelectedContent"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InventoryTabItemStyle" TargetType="TabItem">
            <Setter Property="MinWidth" Value="215"/>
            <Setter Property="MinHeight" Value="58"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="Foreground" Value="#475467"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="HeaderContent"
                                              ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder"
                                        Property="Background"
                                        Value="#F5F8FB"/>
                                <Setter TargetName="TabBorder"
                                        Property="BorderBrush"
                                        Value="#D5DDE7"/>
                                <Setter Property="Foreground"
                                        Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>

                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder"
                                        Property="Background"
                                        Value="{StaticResource PrimaryBrush}"/>
                                <Setter TargetName="TabBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource PrimaryBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Panel.ZIndex" Value="2"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Page.Resources>

    <!-- ============================================================= -->
    <!-- CONTENIDO PRINCIPAL                                           -->
    <!-- ============================================================= -->

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Inventario"
                       Style="{StaticResource PageTitleStyle}"/>
            <TextBlock Text="Administra la información de bins y componentes del sistema."
                       Margin="0,4,0,0"
                       Style="{StaticResource PageSubtitleStyle}"/>
            <Border x:Name="PanelGuiaActualizacion"
                    Visibility="Collapsed"
                    Margin="0,12,0,0" Padding="12,9"
                    Background="#FFF4E5" BorderBrush="#F79009"
                    BorderThickness="1" CornerRadius="8">
                <TextBlock x:Name="TxtGuiaActualizacion"
                           Foreground="#93370D" FontWeight="SemiBold"
                           TextWrapping="Wrap"/>
            </Border>
        </StackPanel>

        <!-- Pestañas -->
        <TabControl x:Name="InventarioTabs" Grid.Row="2"
                    SelectedIndex="0"
                    Style="{StaticResource InventoryTabControlStyle}">
            <TabControl.Tag>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Buscar en inventario"
                                   Margin="0,0,0,4"
                                   Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="TxtBusquedaGlobal"
                                 Style="{StaticResource InputTextBoxStyle}"
                                 ToolTip="Busca por código, descripción, tipo o número de parte"
                                 TextChanged="TxtBusquedaGlobal_TextChanged"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Bottom">
                        <Border Padding="9,8"
                        Background="White"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="7">
                            <TextBlock>
                                <Run Text="Bins "/>
                                <Run x:Name="TxtTotalBins"
                                     Text="0"
                                     FontWeight="SemiBold"
                                     Foreground="{StaticResource PrimaryBrush}"/>
                            </TextBlock>
                        </Border>

                        <Border Margin="6,0,0,0"
                                Padding="9,8"
                                Background="White"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="7">
                            <TextBlock>
                                <Run Text="Componentes "/>
                                <Run x:Name="TxtTotalComponentes"
                                     Text="0"
                                     FontWeight="SemiBold"
                                     Foreground="{StaticResource PrimaryBrush}"/>
                            </TextBlock>
                        </Border>

                        <Border Margin="6,0,0,0"
                                Padding="9,8"
                                Background="#FDECEC"
                                BorderBrush="#F4C7C7"
                                BorderThickness="1"
                                CornerRadius="7">
                            <TextBlock>
                                <Run Text="Pendientes "/>
                                <Run x:Name="TxtComponentesPendientes"
                                     Text="0"
                                     FontWeight="SemiBold"
                                     Foreground="{StaticResource DangerBrush}"/>
                            </TextBlock>
                        </Border>
                    </StackPanel>

                    <Button Grid.Column="4"
                            Content="Actualizar"
                            MinWidth="96"
                            VerticalAlignment="Bottom"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="ActualizarResumen_Click"/>
                </Grid>
            </TabControl.Tag>

            <!-- ========================================================= -->
            <!-- BINS                                                      -->
            <!-- ========================================================= -->

            <TabItem Style="{StaticResource InventoryTabItemStyle}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="▦"
                                   Margin="0,0,11,0"
                                   VerticalAlignment="Center"
                                   FontSize="21"
                                   FontWeight="SemiBold"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Bins"
                                       FontSize="14"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="Ubicaciones de almacenamiento"
                                       Margin="0,2,0,0"
                                       FontSize="11"
                                       Opacity="0.74"/>
                        </StackPanel>
                    </StackPanel>
                </TabItem.Header>
                <Border Margin="0,0,0,4"
                        Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="16"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Formulario de bins -->
                        <Border Grid.Row="0"
                                Style="{StaticResource SectionPanelStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="14"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Text="Información del bin"
                                           Style="{StaticResource SectionTitleStyle}"/>

                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Código"
                                                   Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBox x:Name="TxtBinCodigo"
                                                 Style="{StaticResource InputTextBoxStyle}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Especificaciones"
                                                   Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBox x:Name="TxtBinDescripcion"
                                                 Style="{StaticResource InputTextBoxStyle}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="4"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Bottom">
                                        <Button Content="Agregar"
                                                Margin="0,0,8,0"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Click="AgregarBin_Click"/>
                                        <Button Content="Actualizar"
                                                Margin="0,0,8,0"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Click="ActualizarBin_Click"/>
                                        <Button Content="Eliminar"
                                                Margin="0,0,8,0"
                                                Style="{StaticResource DangerButtonStyle}"
                                                Click="EliminarBin_Click"/>
                                        <Button Content="Limpiar"
                                                Style="{StaticResource NeutralButtonStyle}"
                                                Click="LimpiarBin_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Tabla de bins -->
                        <DataGrid Grid.Row="2"
                                  x:Name="GridBins"
                                  Style="{StaticResource InventoryDataGridStyle}"
                                  SelectionChanged="GridBins_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Código"
                                                    Binding="{Binding Codigo}"
                                                    Width="180"/>
                                <DataGridTextColumn Header="Especificaciones"
                                                    Binding="{Binding Descripcion}"
                                                    Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </TabItem>

            <!-- ========================================================= -->
            <!-- COMPONENTES                                               -->
            <!-- ========================================================= -->

            <TabItem Style="{StaticResource InventoryTabItemStyle}"
                     Margin="0">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="◆"
                                   Margin="0,0,11,0"
                                   VerticalAlignment="Center"
                                   FontSize="18"
                                   FontWeight="SemiBold"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Componentes"
                                       FontSize="14"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="Piezas y tiempos de ciclo"
                                       Margin="0,2,0,0"
                                       FontSize="11"
                                       Opacity="0.74"/>
                        </StackPanel>
                    </StackPanel>
                </TabItem.Header>
                <Border Margin="0,0,0,4"
                        Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="16"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Formulario de componentes -->
                        <Border Grid.Row="0"
                                Style="{StaticResource SectionPanelStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="14"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="14"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Text="Información del componente"
                                           Style="{StaticResource SectionTitleStyle}"/>

                                <!-- Campos principales -->
                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="*" MinWidth="220"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="92"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Número de parte"
                                                   Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBox x:Name="TxtComponenteNumeroParte"
                                                 Style="{StaticResource InputTextBoxStyle}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Tipo"
                                                   Style="{StaticResource FieldLabelStyle}"/>
                                        <ComboBox x:Name="CmbNombreComponente"
                                                  IsEditable="True"
                                                  Style="{StaticResource InputComboBoxStyle}"
                                                  GotFocus="CmbNombreComponente_GotFocus"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Especificación"
                                                   Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBox x:Name="TxtComponenteDescripcion"
                                                 Style="{StaticResource InputTextBoxStyle}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="6">
                                        <TextBlock Text="Nivel de tiempo"
                                                   Style="{StaticResource FieldLabelStyle}"/>
                                        <ComboBox x:Name="CmbNivelTiempo"
                                                  Style="{StaticResource InputComboBoxStyle}"
                                                  SelectionChanged="CmbNivelTiempo_SelectionChanged">
                                            <ComboBoxItem Content="Nivel 1 — 2 seg" Tag="2"/>
                                            <ComboBoxItem Content="Nivel 2 — 4 seg" Tag="4"/>
                                            <ComboBoxItem Content="Nivel 3 — 6 seg" Tag="6"/>
                                            <ComboBoxItem Content="Nivel 4 — 8 seg" Tag="8"/>
                                            <ComboBoxItem Content="Nivel 5 — 10 seg" Tag="10"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Grid.Column="8">
                                        <TextBlock Text="Tiempo"
                                                   Style="{StaticResource FieldLabelStyle}"/>
                                        <Border Height="36"
                                                Padding="10,0"
                                                Background="{StaticResource PrimaryLightBrush}"
                                                BorderBrush="#CFE2F6"
                                                BorderThickness="1"
                                                CornerRadius="7">
                                            <TextBlock x:Name="TxtTiempoCicloSeleccionado"
                                                       Text="— seg"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{StaticResource PrimaryBrush}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <!-- Fotografía y acciones -->
                                <Grid Grid.Row="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Button x:Name="BtnSeleccionarFotoComponente" Grid.Column="0"
                                            Content="Seleccionar foto"
                                            MinWidth="130"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Click="SeleccionarFotoComponente_Click"/>

                                    <TextBlock Grid.Column="2"
                                               x:Name="TxtRutaFotoComponente"
                                               Text="Sin imagen"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="12"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>

                                    <StackPanel Grid.Column="4"
                                                Orientation="Horizontal">
                                        <Button Content="Agregar"
                                                Margin="0,0,8,0"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Click="AgregarComponente_Click"/>
                                        <Button x:Name="BtnActualizarComponente" Content="Actualizar"
                                                Margin="0,0,8,0"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Click="ActualizarComponente_Click"/>
                                        <Button Content="Eliminar"
                                                Margin="0,0,8,0"
                                                Style="{StaticResource DangerButtonStyle}"
                                                Click="EliminarComponente_Click"/>
                                        <Button Content="Limpiar"
                                                Style="{StaticResource NeutralButtonStyle}"
                                                Click="LimpiarComponente_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Tabla y fotografía -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="520"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="340" MinWidth="280"/>
                            </Grid.ColumnDefinitions>

                            <DataGrid Grid.Column="0"
                                      x:Name="GridComponentes"
                                      Style="{StaticResource InventoryDataGridStyle}"
                                      SelectionChanged="GridComponentes_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Tipo"
                                                        Binding="{Binding Nombre}"
                                                        Width="120"/>
                                    <DataGridTextColumn Header="No. de parte"
                                                        Binding="{Binding NumeroParte}"
                                                        Width="130"/>
                                    <DataGridTextColumn Header="Especificación"
                                                        Binding="{Binding Descripcion}"
                                                        Width="*"
                                                        MinWidth="180"/>
                                    <DataGridTextColumn Header="Tiempo (seg)"
                                                        Binding="{Binding TiempoCiclo}"
                                                        Width="95"/>
                                    <DataGridTemplateColumn Header="Estatus"
                                                            CellTemplate="{StaticResource EstatusTemplate}"
                                                            Width="120"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Vista previa de fotografía -->
                            <Border Grid.Column="2"
                                    Background="{StaticResource SoftBackgroundBrush}"
                                    BorderBrush="#E4E7EC"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="16">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="12"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="12"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0"
                                               Text="Foto del componente"
                                               HorizontalAlignment="Center"
                                               Style="{StaticResource SectionTitleStyle}"/>

                                    <Border Grid.Row="2"
                                            MinHeight="250"
                                            Background="White"
                                            BorderBrush="#E4E7EC"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="10">
                                        <Image x:Name="ImgComponente"
                                               Stretch="Uniform"
                                               MaxHeight="420"
                                               MaxWidth="300"/>
                                    </Border>

                                    <TextBlock Grid.Row="4"
                                               x:Name="TxtSinImagen"
                                               Text="Sin imagen seleccionada"
                                               HorizontalAlignment="Center"
                                               Foreground="#98A2B3"
                                               FontSize="13"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </TabItem>

        </TabControl>
    </Grid>
</Page>
