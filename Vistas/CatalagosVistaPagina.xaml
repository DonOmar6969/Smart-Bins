<Page x:Class="SmartBins.Vistas.CatalogosVistaPagina"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Catálogos">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Catálogos" FontSize="22"
                   FontWeight="Bold" Foreground="#0066CC" Margin="0,0,0,20"/>

        <TabControl Grid.Row="1">

            <!-- Pestaña Bins -->
            <TabItem Header="Bins">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                        <!-- Bins -->
                        <Label Content="Código:" Foreground="#333333" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtBinCodigo" Width="150" Margin="0,0,10,0"
                                VerticalContentAlignment="Center" Height="35"/>
                        <Label  Content="Especificaciones" Foreground="#333333" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtBinDescripcion" Width="250" Margin="0,0,10,0"
                                VerticalContentAlignment="Center" Height="35"/>
                        <Button Content="Agregar" Width="80" Height="35" Margin="0,0,5,0"
                                Background="#0066CC" Foreground="White" BorderThickness="0"
                                Cursor="Hand" Click="AgregarBin_Click"/>
                        <Button Content="Actualizar" Width="80" Height="35" Margin="0,0,5,0"
                                Background="#0066CC" Foreground="White" BorderThickness="0"
                                Cursor="Hand" Click="ActualizarBin_Click"/>
                        <Button Content="Eliminar" Width="80" Height="35" Margin="0,0,5,0"
                                Background="#CC0000" Foreground="White" BorderThickness="0"
                                Cursor="Hand" Click="EliminarBin_Click"/>
                        <Button Content="Limpiar" Width="80" Height="35"
                                Background="#888888" Foreground="White" BorderThickness="0"
                                Cursor="Hand" Click="LimpiarBin_Click"/>
                    </StackPanel>

                    <DataGrid Grid.Row="1" x:Name="GridBins" AutoGenerateColumns="False"
                              IsReadOnly="True" SelectionChanged="GridBins_SelectionChanged"
                              Background="White" BorderBrush="#DDDDDD" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#EEEEEE" RowHeight="35" FontSize="13">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="150"/>
                            <DataGridTextColumn Header="Especificaciones" Binding="{Binding Descripcion}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Pestaña Componentes -->
            <TabItem Header="Componentes">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*"/>
                        <ColumnDefinition Width="362*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15" Grid.ColumnSpan="2">
                        <Label Content="Tipo:" VerticalAlignment="Center" Foreground="#333333"/>
                        <ComboBox x:Name="CmbNombreComponente" Width="150" Height="35" 
                                Margin="0,0,10,0" IsEditable="True"
                                GotFocus="CmbNombreComponente_GotFocus"/>
                        <Label  Content="Especificación:" VerticalAlignment="Center" Foreground="#333333"/>
                        <TextBox x:Name="TxtComponenteDescripcion" Width="250" Margin="0,0,10,0"
                                VerticalContentAlignment="Center" Height="35"/>
                        <Button Content="Agregar" Width="80" Height="35" Margin="0,0,5,0"
                                Background="#0066CC" Foreground="White" BorderThickness="0"
                                Cursor="Hand" Click="AgregarComponente_Click"/>
                        <Button Content="Actualizar" Width="80" Height="35" Margin="0,0,5,0"
                                Background="#0066CC" Foreground="White" BorderThickness="0"
                                Cursor="Hand" Click="ActualizarComponente_Click"/>
                        <Button Content="Eliminar" Width="80" Height="35" Margin="0,0,5,0"
                                Background="#CC0000" Foreground="White" BorderThickness="0"
                                Cursor="Hand" Click="EliminarComponente_Click"/>
                        <Button Content="Limpiar" Width="80" Height="35"
                                Background="#888888" Foreground="White" BorderThickness="0"
                                Cursor="Hand" Click="LimpiarComponente_Click"/>
                    </StackPanel>

                    <DataGrid Grid.Row="1" x:Name="GridComponentes" AutoGenerateColumns="False"
                              IsReadOnly="True" SelectionChanged="GridComponentes_SelectionChanged"
                              Background="White" BorderBrush="#DDDDDD" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#EEEEEE" RowHeight="35" FontSize="13" Grid.ColumnSpan="2">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="150"/>
                            <DataGridTextColumn Header="Especificacion" Binding="{Binding Descripcion}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Page>