<Page x:Class="SmartBins.Vistas.InicioVistaPagina"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Inicio" Loaded="InicioVistaPagina_Loaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="28" Background="#F5F7FA">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="22"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="22"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="Panel principal" FontSize="28" FontWeight="Bold" Foreground="#1D2939"/>
                <TextBlock Text="Resumen operativo de Smart Bins" Margin="0,5,0,0" FontSize="14" Foreground="#667085"/>
            </StackPanel>
            <UniformGrid Grid.Row="2" Columns="4">
                <Border Margin="0,0,12,0" Padding="18" Background="White" CornerRadius="12">
                    <StackPanel><TextBlock Text="Ensambles" Foreground="#667085"/><TextBlock x:Name="TxtEnsambles" Text="—" Margin="0,8,0,0" Foreground="#0066CC" FontSize="30" FontWeight="Bold"/></StackPanel>
                </Border>
                <Border Margin="0,0,12,0" Padding="18" Background="White" CornerRadius="12">
                    <StackPanel><TextBlock Text="Componentes" Foreground="#667085"/><TextBlock x:Name="TxtComponentes" Text="—" Margin="0,8,0,0" Foreground="#344054" FontSize="30" FontWeight="Bold"/></StackPanel>
                </Border>
                <Border Margin="0,0,12,0" Padding="18" Background="White" CornerRadius="12">
                    <StackPanel><TextBlock Text="Por actualizar" Foreground="#667085"/><TextBlock x:Name="TxtDesactualizados" Text="—" Margin="0,8,0,0" Foreground="#C62828" FontSize="30" FontWeight="Bold"/></StackPanel>
                </Border>
                <Border Padding="18" Background="White" CornerRadius="12">
                    <StackPanel><TextBlock Text="Ensambles incompletos" Foreground="#667085"/><TextBlock x:Name="TxtIncompletos" Text="—" Margin="0,8,0,0" Foreground="#C77700" FontSize="30" FontWeight="Bold"/></StackPanel>
                </Border>
            </UniformGrid>
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Padding="20" Background="White" CornerRadius="12">
                    <StackPanel><TextBlock Text="Estado del sistema" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="TxtEstado" Margin="0,14,0,0" TextWrapping="Wrap" Foreground="#475467"/></StackPanel>
                </Border>
                <Border Grid.Column="2" Padding="20" Background="#EAF4EC" CornerRadius="12">
                    <StackPanel><TextBlock Text="Siguiente acción recomendada" FontSize="15" FontWeight="SemiBold" Foreground="#245C32"/><TextBlock x:Name="TxtRecomendacion" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="#376B44"/></StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
