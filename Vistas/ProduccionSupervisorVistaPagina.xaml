<Page x:Class="SmartBins.Vistas.ProduccionSupervisorVistaPagina"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F4F6F8">
    <Page.Resources>
        <Style x:Key="CardProduccion" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E1E6EC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="22"/>
        </Style>
        <Style x:Key="EtiquetaCampo" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#344054"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Producción" FontSize="28" FontWeight="Bold" Foreground="#1D2939"/>
                    <TextBlock Text="Prepara, valida y ejecuta una corrida de producción."
                               Margin="0,6,0,0" FontSize="14" Foreground="#667085"/>
                </StackPanel>
                <Border Grid.Column="1" Padding="12,7" VerticalAlignment="Center"
                        Background="#E8F3EA" BorderBrush="#B7D8BE"
                        BorderThickness="1" CornerRadius="16">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Margin="0,0,7,0"
                                 VerticalAlignment="Center" Fill="#2E7D32"/>
                        <TextBlock Text="Supervisión disponible" Foreground="#2E6B3D"
                                   FontSize="12" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="6*"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource CardProduccion}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="18"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="16"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="16"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="1. Configuración de la corrida" FontSize="17"
                                       FontWeight="SemiBold" Foreground="#1D2939"/>
                            <TextBlock Text="Define el modelo y los recursos que participarán."
                                       Margin="0,4,0,0" FontSize="12" Foreground="#667085"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2">
                            <TextBlock Text="Ensamble" Style="{StaticResource EtiquetaCampo}"/>
                            <ComboBox x:Name="CmbEnsamble" Margin="0,7,0,0" Height="40"
                                      Padding="10,0" DisplayMemberPath="Nombre"
                                      Style="{StaticResource ProfessionalComboBoxStyle}"
                                      SelectionChanged="CmbEnsamble_SelectionChanged"/>
                        </StackPanel>

                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Operadores para esta corrida" Style="{StaticResource EtiquetaCampo}"/>
                                <TextBox x:Name="TxtOperadores" Text="1" Margin="0,7,0,0"
                                         ToolTip="Puedes ajustar esta cantidad sin modificar el ensamble"
                                         Style="{StaticResource ProfessionalTextBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Unidades de prueba" Style="{StaticResource EtiquetaCampo}"/>
                                <TextBox x:Name="TxtCantidadUnidades" Text="1" Margin="0,7,0,0"
                                         Style="{StaticResource ProfessionalTextBoxStyle}"/>
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="6" Padding="12,10" Background="#F7F9FB" CornerRadius="8">
                            <TextBlock Text="Los datos se validarán antes de generar el reporte o iniciar la corrida."
                                       TextWrapping="Wrap" FontSize="11" Foreground="#667085"/>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardProduccion}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="14"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="2. Resultado del balance" FontSize="17"
                                           FontWeight="SemiBold" Foreground="#1D2939"/>
                                <TextBlock Text="Distribución estimada de la carga de trabajo."
                                           Margin="0,4,0,0" FontSize="12" Foreground="#667085"/>
                            </StackPanel>
                            <Border Grid.Column="1" Padding="9,5" Background="#EEF5FC" CornerRadius="12">
                                <TextBlock Text="Vista previa" Foreground="#1F5F99" FontSize="11"/>
                            </Border>
                        </Grid>
                        <Border Grid.Row="2" Padding="18" MinHeight="210"
                                Background="#F7FAFD" BorderBrush="#DCE8F3"
                                BorderThickness="1" CornerRadius="9">
                            <TextBlock x:Name="TxtResumenBalance"
                                       Text="Selecciona un ensamble y presiona “Calcular balance” para consultar la distribución."
                                       TextWrapping="Wrap" LineHeight="23"
                                       VerticalAlignment="Center"
                                       Foreground="#475467" FontSize="13"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="4" Padding="16" Background="White"
                    BorderBrush="#E1E6EC" BorderThickness="1" CornerRadius="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="30" Height="30" Background="#EEF2F6" CornerRadius="15">
                            <TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontWeight="Bold" Foreground="#475467"/>
                        </Border>
                        <TextBlock Text="Acciones de producción" Margin="10,0,0,0"
                                   VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#344054"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Content="Calcular balance" MinWidth="150"
                                Margin="0,0,10,0" Click="CalcularBalance_Click"
                                Style="{StaticResource ProfessionalSecondaryButtonStyle}"/>
                        <Button x:Name="BtnDescargarReporte" Content="Descargar PDF"
                                MinWidth="145" Margin="0,0,10,0"
                                Click="DescargarReporte_Click"
                                Style="{StaticResource ProfessionalSecondaryButtonStyle}"
                                IsEnabled="False"/>
                        <Button x:Name="BtnIniciarCorrida" Content="▶  Iniciar corrida"
                                MinWidth="170" Click="IniciarCorrida_Click"
                                Style="{StaticResource ProfessionalPrimaryButtonStyle}"
                                IsEnabled="False"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
